{
    "info": {
        "name": "Auth API — Laravel Sanctum + Gmail",
        "description": "Collection complète pour tester l'API d'authentification avec vérification email OTP.\n\n**Setup :**\n1. Importez cette collection dans Postman\n2. Créez un environnement avec les variables listées ci-dessous\n3. Lancez d'abord `Register User` — le token est sauvegardé automatiquement",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },

    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost:8000/api",
            "type": "string"
        },
        { "key": "token", "value": "", "type": "string" },
        {
            "key": "user_email",
            "value": "testuser@gmail.com",
            "type": "string"
        },
        { "key": "otp_code", "value": "", "type": "string" }
    ],

    "item": [
        {
            "name": "🔓 Auth Public",
            "item": [
                {
                    "name": "Register User",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "const res = pm.response.json();",
                                    "",
                                    "pm.test('Status 201', () => pm.response.to.have.status(201));",
                                    "pm.test('success = true', () => pm.expect(res.success).to.be.true);",
                                    "pm.test('Token présent', () => pm.expect(res.token).to.be.a('string'));",
                                    "pm.test('User retourné', () => pm.expect(res.user).to.be.an('object'));",
                                    "pm.test('email_verified_at est null', () => pm.expect(res.user.email_verified_at).to.be.null);",
                                    "",
                                    "if (res.token) {",
                                    "    pm.collectionVariables.set('token', res.token);",
                                    "    console.log('✅ Token sauvegardé :', res.token);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            { "key": "Accept", "value": "application/json" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"firstname\": \"Jean\",\n  \"lastname\": \"Dupont\",\n  \"email\": \"{{user_email}}\",\n  \"password\": \"Password123!\",\n  \"password_confirmation\": \"Password123!\",\n  \"phone\": \"+237600000000\",\n  \"avatar\": \"https://example.com/avatar.png\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/auth/register",
                            "host": ["{{base_url}}"],
                            "path": ["auth", "register"]
                        }
                    }
                },

                {
                    "name": "Register User — Email déjà utilisé (422)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
